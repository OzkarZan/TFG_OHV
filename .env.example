# ========================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO
# Copia este archivo a .env y añade tus credenciales reales.
# ========================================

# ========================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ========================================
# Obtén estos valores de: https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5500/backend/api/google-callback.php

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Credenciales para la conexión a MySQL
DB_HOST=db
DB_NAME=autosync_db
DB_USER=root
DB_PASSWORD=root

# ========================================
# APPLICATION CONFIGURATION
# ========================================
APP_ENV=development
APP_DEBUG=true
API_BASE_URL=http://localhost:5500

# ========================================
# SECURITY
# ========================================
# Cambia esto en producción con una clave muy segura
JWT_SECRET=your-secret-key-change-this-in-production
